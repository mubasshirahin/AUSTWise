{
  "name": "aust-helper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs --vite",
    "dev:static": "npm run build && node server/dev.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "start": "node server/dev.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "node dev/seed-data.mjs",
    "db:status": "prisma migrate status --schema server/prisma/schema.prisma",
    "render:build": "npm run db:generate && npm run db:deploy && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.16.0",
    "pdf-parse": "^2.4.5",
    "pdfjs": "^2.5.4",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.16.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  }
}
