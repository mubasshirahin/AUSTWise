# ─── AUSTWise Environment Variables ───
# Copy this file to .env and fill in your real values.
# .env is gitignored and will never be committed.

# ─── OAuth / Social Login ───
# GitHub OAuth App credentials (https://github.com/settings/developers)
# Redirect URL: http://localhost:5174/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth App credentials (https://discord.com/developers/applications)
# Redirect URL: http://localhost:5174/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Spotify OAuth App credentials (https://developer.spotify.com/dashboard)
# Redirect URL: http://localhost:5174/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Facebook OAuth App credentials (https://developers.facebook.com/apps)
# Redirect URL: http://localhost:5174/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Steam API key (https://steamcommunity.com/dev/apikey)
# Notes: Only needs domain authorization, no redirect URL required
STEAM_API_KEY=

# ─── AI / API Keys ───
# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# OpenAI model for routine extraction (default: gpt-4.1)
OPENAI_ROUTINE_MODEL=gpt-4.1

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google API key for Drive & YouTube (https://console.cloud.google.com/apis/credentials)
# Requires Drive + YouTube API scopes enabled
VITE_GOOGLE_API_KEY=

# OAuth 2.0 Client ID for Google Classroom integration
# Generated under same console -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=

# ─── Telegram ───
# Telegram Bot Token from @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Secret token sent back by Telegram on every webhook update
# (X-Telegram-Bot-Api-Secret-Token). REQUIRED in production — webhook updates
# are rejected when unset. Set it, then re-run the webhook setup so Telegram
# stores it:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# ─── Database (PostgreSQL) ───
# One-connection-string form (Railway Postgres injects DATABASE_URL).
# Local dev: postgresql://USER:PASSWORD@localhost:5432/austwise
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/austwise"

# Or the split form (used when DATABASE_URL is empty):
DB_SERVER=localhost
DB_DATABASE=austwise
DB_USER=postgres
DB_PASSWORD=your_strong_password_here
DB_PORT=5432

# ─── Server ───
PORT=5174

# Public base URL of the app (e.g. https://austwise.example.com). Used to build
# OAuth callback redirect URIs and the app origin for OAuth popup postMessage,
# so redirect_uri / postMessage never trust the client Host header.
# Leave empty for local dev (localhost is auto-detected).
PUBLIC_BASE_URL=

# WebSocket endpoint the browser connects to for real-time messaging/presence.
# Required in production when the frontend (Vercel) and backend (Render) are
# on different hosts — Vercel rewrites don't proxy WebSocket upgrades, so point
# this directly at the backend, e.g. VITE_WS_URL=wss://austwise.onrender.com
# Leave empty in local dev (same-origin /api/ws is used).
VITE_WS_URL=

# Set to 1 when serving over HTTPS so the auth cookie is marked Secure
# (only sent over TLS). Leave off for plain-HTTP local dev.
COOKIE_SECURE=0

# Comma-separated list of allowed CORS origins. Empty = same-origin only
# (recommended since the SPA is served by this same server).
# REQUIRED in production split-host (Vercel frontend + Railway backend) — add
# your Vercel domain here so the browser's cross-origin WebSocket upgrade to
# the backend is accepted: ALLOWED_ORIGIN=https://your-app.vercel.app
# Example: ALLOWED_ORIGIN=https://austwise.example.com,https://app.example.com
ALLOWED_ORIGIN=

# Security headers. Enabling CSP can break inline-style/external-embed heavy
# features, so it's opt-in. Set ENABLE_CSP=1 and a CSP_HEADER tuned to your site.
ENABLE_CSP=0
# CSP_HEADER="default-src 'self'"

# HSTS — set ENABLE_HSTS=1 only when serving over HTTPS
ENABLE_HSTS=0

# ─── Library Occupancy Geofence ───
LIBRARY_LAT=23.7634
LIBRARY_LNG=90.4074
LIBRARY_RADIUS_M=80
LIBRARY_CAPACITY=120

# ─── SSLCommerz Payment Gateway ───
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_IS_LIVE=false

# ─── Auth ───
# JWT secret key for signing auth tokens — generate a random 64-byte hex string
# Generate command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Default admin seed password (only used when seeding the initial admin account on first run)
# CHANGE THIS in production! Must be >= 12 characters — in production the admin
# account is NOT seeded (fail-closed) if this is unset or too short.
# NOTE: server-only — do NOT rename this to a VITE_* var, or Vite will embed the
# real admin password into the client JS bundle.
ADMIN_DEFAULT_PASSWORD=

# ─── Password Vault encryption key (AES-256-GCM) ───
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CRYPTO_SECRET_KEY=

# ─── Rate Limiting (optional — has sensible defaults) ───
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_EXTRACT_WINDOW_MS=3600000
RATE_LIMIT_EXTRACT_MAX=10
