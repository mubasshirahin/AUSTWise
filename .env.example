# ─── AUSTWise Environment Variables ───
# Copy this file to .env and fill in your real values.
# .env is gitignored and will never be committed.

# ─── OAuth / Social Login ───
# GitHub OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth App credentials (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Spotify OAuth App credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Facebook OAuth App credentials (https://developers.facebook.com/apps)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Steam API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# ─── AI / API Keys ───
# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# OpenAI model for routine extraction (default: gpt-4.1)
OPENAI_ROUTINE_MODEL=gpt-4.1

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google API key for Drive & YouTube (https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_API_KEY=

# OAuth 2.0 Client ID for Google Classroom integration
VITE_GOOGLE_CLIENT_ID=

# ─── Telegram ───
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# ─── Database (SQL Server) ───
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=AUSTWise
DB_USER=sa
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUSTED=false
# Prisma connection string (for prisma.config.ts)
DATABASE_URL=sqlserver://localhost:1433;database=austwise;integratedSecurity=true;encrypt=true;trustServerCertificate=true

# ─── Server ───
PORT=5174

# ─── Library Occupancy Geofence ───
# LIBRARY_LAT=23.7634
# LIBRARY_LNG=90.4074
# LIBRARY_RADIUS_M=80
# LIBRARY_CAPACITY=120

# ─── SSLCommerz Payment Gateway ───
# SSL_STORE_ID=
# SSL_STORE_PASSWORD=
# SSL_IS_LIVE=false

# ─── Auth ───
# JWT secret key for signing auth tokens — generate a random 64-byte hex string
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Default admin seed password (only used when seeding the initial admin account on first run)
# CHANGE THIS in production!
VITE_ADMIN_DEFAULT_PASSWORD=admin123

# ─── Rate Limiting (optional — has sensible defaults) ───
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_EXTRACT_WINDOW_MS=3600000
# RATE_LIMIT_EXTRACT_MAX=10
