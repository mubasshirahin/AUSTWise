# ─── AUSTWise Environment Variables ───
# Copy this file to .env and fill in your real values.
# .env is gitignored and will never be committed.

# ─── OAuth / Social Login ───
# GitHub OAuth App credentials (https://github.com/settings/developers)
# Redirect URL: http://localhost:5174/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth App credentials (https://discord.com/developers/applications)
# Redirect URL: http://localhost:5174/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Spotify OAuth App credentials (https://developer.spotify.com/dashboard)
# Redirect URL: http://localhost:5174/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Facebook OAuth App credentials (https://developers.facebook.com/apps)
# Redirect URL: http://localhost:5174/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Steam API key (https://steamcommunity.com/dev/apikey)
# Notes: Only needs domain authorization, no redirect URL required
STEAM_API_KEY=

# ─── AI / API Keys ───
# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# OpenAI model for routine extraction (default: gpt-4.1)
OPENAI_ROUTINE_MODEL=gpt-4.1

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google API key for Drive & YouTube (https://console.cloud.google.com/apis/credentials)
# Requires Drive + YouTube API scopes enabled
VITE_GOOGLE_API_KEY=

# OAuth 2.0 Client ID for Google Classroom integration
# Generated under same console -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=

# ─── Telegram ───
# Telegram Bot Token from @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# ─── Database (SQL Server) ───
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=AUSTWise
DB_USER=sa
DB_PASSWORD=your_strong_password_here
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUSTED=false

# Prisma connection string (for prisma.config.ts)
# Replace user, password, and settings based on individual credentials above
DATABASE_URL="sqlserver://localhost:1433;database=AUSTWise;user=sa;password=your_strong_password_here;encrypt=false;trustServerCertificate=false;"

# ─── Server ───
PORT=5174

# ─── Library Occupancy Geofence ───
LIBRARY_LAT=23.7634
LIBRARY_LNG=90.4074
LIBRARY_RADIUS_M=80
LIBRARY_CAPACITY=120

# ─── SSLCommerz Payment Gateway ───
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_IS_LIVE=false

# ─── Auth ───
# JWT secret key for signing auth tokens — generate a random 64-byte hex string
# Generate command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Default admin seed password (only used when seeding the initial admin account on first run)
# CHANGE THIS in production!
VITE_ADMIN_DEFAULT_PASSWORD=

# ─── Password Vault encryption key (AES-256-GCM) ───
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CRYPTO_SECRET_KEY=

# ─── Rate Limiting (optional — has sensible defaults) ───
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_EXTRACT_WINDOW_MS=3600000
RATE_LIMIT_EXTRACT_MAX=10