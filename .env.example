# ─── AUSTWise environment variables (copy to .env and fill in real values) ───
#   cp .env.example .env
#
# ⚠️ .env is gitignored — never commit real secrets.

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection string — used by the running app (server/prisma.js).
#   In Neon: Connection string → Prisma (pooled) → "Use connection pooling"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER.neon.tech/austwise?sslmode=require&pgbouncer=true"

# Direct connection string — used by Prisma CLI for migrations (prisma.config.ts)
# and seed scripts. In Neon: Prisma (direct) → "Connection string only"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/austwise?sslmode=require"

# ─── CORS (Render backend ← Vercel frontend) ──────────────────────────────────
# Comma-separated list of allowed browser origins (no wildcard '*').
FRONTEND_URL="https://your-project.vercel.app"
# ALLOWED_ORIGINS="https://app.austwise.com,https://preview-abc.austwise.com"

# ─── Auth & Cookies ───────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
# Cookie lifetime in seconds (default 86400 = 1 day)
# COOKIE_MAX_AGE=86400
# Seeded admin account password (server/userStore.mjs seeds admin@aust.edu)
ADMIN_DEFAULT_PASSWORD="change-me"

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000

# ─── AI / Integrations (optional — app starts without them) ───────────────────
OPENAI_API_KEY=""
TELEGRAM_BOT_TOKEN=""
GEMINI_API_KEY=""
VITE_GOOGLE_API_KEY=""

# ─── Social OAuth (optional) ───────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
STEAM_API_KEY=""

# ─── Library geofence (optional) ───────────────────────────────────────────────
# LIBRARY_LAT=23.7634
# LIBRARY_LNG=90.4074
# LIBRARY_RADIUS_M=80
# LIBRARY_CAPACITY=120

# ─── Rate limits (optional) ────────────────────────────────────────────────────
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_EXTRACT_WINDOW_MS=3600000
# RATE_LIMIT_EXTRACT_MAX=10

# ─── Deployment notes ──────────────────────────────────────────────────────────
# After the first `npm run db:deploy` against Neon, run the one-time seed once:
#   npm run db:seed        # inserts courses + campus locations (idempotent)
# migrate deploy does NOT run the seed automatically.
