{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://austwise-production.up.railway.app/api/:path*"
    },
    {
      "source": "/__dev/:path*",
      "destination": "https://austwise-production.up.railway.app/__dev/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://austwise-production.up.railway.app/socket.io/:path*"
    }
  ]
}
